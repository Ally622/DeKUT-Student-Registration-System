# Daraja API Credentials
# Get these from https://developer.safaricom.co.ke/
CONSUMER_KEY=
CONSUMER_SECRET=

# Business Short Code
# Sandbox: 174379
# Production: Your actual short code
BUSINESS_SHORT_CODE=174379

# Passkey
# Get from Daraja portal
PASSKEY=

# Server Configuration
PORT=3000

# Callback URL
# This must be publicly accessible (use ngrok for local testing)
CALLBACK_URL=https://your-domain.example/api/mpesa-callback
# Firebase Configuration (Optional)
FIREBASE_DATABASE_URL=https://your-firebase-project.firebaseio.com
