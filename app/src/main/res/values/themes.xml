<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Main Application Theme -->
    <style name="Base.Theme.DeKUTStudentRegistration"
        parent="Theme.Material3.Light.NoActionBar">

        <item name="colorPrimary">@color/dekut_red</item>
        <item name="colorPrimaryDark">@color/dekut_red_dark</item>
        <item name="colorAccent">@color/dekut_red</item>

        <item name="android:statusBarColor">@color/dekut_red_dark</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">false</item>

        <item name="android:windowBackground">@color/background_light</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

    </style>

    <style name="Theme.DeKUTStudentRegistration"
        parent="Base.Theme.DeKUTStudentRegistration" />

    <!-- Card Styling -->
    <style name="CardStyle">
        <item name="android:layout_margin">16dp</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">4dp</item>
        <item name="android:background">@color/card_background</item>
    </style>

    <!-- Primary Green Button -->
    <style name="ButtonPrimary" parent="Widget.Material3.Button">
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/dekut_red</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:padding">16dp</item>
    </style>

    <!-- Secondary Outlined Button -->
    <style name="ButtonSecondary"
        parent="Widget.Material3.Button.OutlinedButton">

        <item name="android:textColor">@color/dekut_red</item>
        <item name="strokeColor">@color/dekut_red</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:padding">16dp</item>

    </style>

    <!-- Input Field Styling -->
    <style name="EditTextStyle"
        parent="Widget.Material3.TextInputLayout.OutlinedBox">

        <item name="boxStrokeColor">@color/dekut_red</item>
        <item name="hintTextColor">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_secondary</item>

    </style>

    <!-- Section Heading -->
    <style name="SectionTitle">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/dekut_red</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

</resources>

