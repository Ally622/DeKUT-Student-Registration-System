<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" app:cardCornerRadius="8dp" app:cardBackgroundColor="@color/dekut_red">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp" android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="💳 M-Pesa Fees Payment" android:textColor="@color/white"
                    android:textSize="20sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:text="Pay your fees via M-Pesa"
                    android:textColor="@color/white" android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Student info (auto-filled) -->
        <TextView android:id="@+id/tvStudentInfo"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="12dp" android:padding="12dp" android:background="#E8F5E9"
            android:text="Loading student info..." android:textColor="@color/text_primary" android:textSize="14sp" />

        <!-- Form Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            app:cardCornerRadius="12dp" app:cardElevation="4dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">

                <!-- Phone Number -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp" style="@style/EditTextStyle"
                    android:hint="M-Pesa Phone Number (254XXXXXXXXX)">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPhoneNumber" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="phone" android:maxLength="12" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Amount -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp" style="@style/EditTextStyle"
                    android:hint="Amount (KES)" app:prefixText="KES ">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etAmount" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Info Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp" app:cardCornerRadius="8dp" app:cardBackgroundColor="#E3F2FD">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:padding="12dp"
                        android:text="ℹ️ Steps:\n1. Enter your M-Pesa phone number\n2. Enter the amount\n3. Tap Pay Now\n4. Enter your M-Pesa PIN on your phone\n5. Await confirmation"
                        android:textSize="12sp" android:lineSpacingExtra="4dp" android:textColor="@color/text_secondary" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Buttons -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClear" style="@style/ButtonSecondary"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:layout_marginEnd="8dp" android:text="@string/clear" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPayNow" style="@style/ButtonPrimary"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="Pay Now" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Payment Status Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPaymentStatus"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" app:cardCornerRadius="8dp" app:cardElevation="4dp"
            android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Payment Status" android:textStyle="bold" android:textSize="16sp"
                    android:textColor="@color/dekut_red" />
                <TextView android:id="@+id/tvPaymentStatus"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:textSize="14sp" android:textColor="@color/text_primary" />
                <TextView android:id="@+id/tvTransactionRef"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:textSize="12sp" android:textColor="@color/text_secondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
